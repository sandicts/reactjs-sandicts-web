{
  "name": "reactjs-sandicts-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "api:generate": "orval --config orval.config.ts --fail-on-warnings",
    "api:check": "npm run api:generate && git diff --exit-code -- src/lib/api/generated/sandicts-api",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:ci": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.0",
    "lucide-react": "1.18.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "orval": "^8.17.0",
    "prettier": "^3.9.1",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "js-yaml": "^4.2.0",
    "next": {
      "postcss": "8.5.15"
    }
  }
}
